# Copy this file to .env (already gitignored) and fill in the values the
# incident-response service needs to run the headless coding agent.

# Required if your agent CLI authenticates via API key (e.g. Claude Code
# without an existing `claude login` session). Leave blank if the agent
# picks up credentials another way.
ANTHROPIC_API_KEY=

# Override if you use a different headless coding agent/CLI than Claude
# Code. The responder pipes the incident prompt to this command via stdin.
# AGENT_CMD=claude -p --dangerously-skip-permissions
